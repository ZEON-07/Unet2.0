{
  "name": "inklife-api",
  "version": "0.1.0",
  "private": true,
  "description": "InkLife pen lifecycle tracking API – SQLite & Prisma Node.js backend",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "tsx src/tests/sqlite.test.ts && tsx src/tests/prediction.engine.test.ts && tsx src/tests/claim.extractor.test.ts",
    "test:watch": "tsx watch src/tests/prediction.engine.test.ts",
    "test:e2e": "tsx src/tests/e2e.verify.ts",
    "type-check": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@hono/zod-openapi": "^0.16.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.33.0",
    "fastify": "^5.12.4",
    "hono": "^4.6.0",
    "jose": "^5.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "@types/node": "^22.20.2",
    "drizzle-kit": "^0.24.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.0"
  }
}
