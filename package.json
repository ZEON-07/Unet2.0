{
  "name": "inklife-api",
  "version": "0.1.0",
  "private": true,
  "description": "InkLife pen lifecycle tracking API – Cloudflare Workers backend",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply inklife-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply inklife-db --remote",
    "db:seed:local": "wrangler d1 execute inklife-db --local --file=drizzle/seed.sql",
    "db:seed:remote": "wrangler d1 execute inklife-db --remote --file=drizzle/seed.sql",
    "db:studio": "drizzle-kit studio",
    "test": "tsx src/tests/prediction.engine.test.ts",
    "test:watch": "tsx watch src/tests/prediction.engine.test.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.16.0",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.6.0",
    "jose": "^5.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.0"
  }
}
